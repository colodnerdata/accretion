#!/bin/sh
# Pre-commit hook: run the same checks as CI before a commit is created.
#
#   1. web/accretion.html must match the web sources (python tools/build.py).
#   2. Lint, format check, and tests (uv run poe check).
#
# Install once per clone:  uv run poe hooks
# Skip in an emergency:    git commit --no-verify
#
# The checks read the working tree, not the index, so with partially staged
# files (git add -p) they can pass or fail on changes you are not committing.

set -e
cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: checking that web/accretion.html is current"
if ! uv run --locked python tools/build.py --check; then
    echo "pre-commit: rebuild and stage it:  python tools/build.py && git add web/accretion.html" >&2
    exit 1
fi

echo "pre-commit: running uv run poe check"
uv run --locked poe check
